# --- Secrets / local env ---
.env
.env.*
!.env.example
*.local.env

# --- Desktop tool runtime data (local workspace) ---
data/
scripts/desktop_tools.local.cmd

# --- infra (Docker) — keep compose + init SQL; ignore local runtime ---
infra/.env
infra/.env.local
infra/.env.*.local
infra/pgdata/
infra/postgres/data/
docker-compose.override.yml
infra/docker-compose.override.yml

# --- logs (local cmd-era / debug output) ---
logs/*
!logs/.gitkeep
*.log
*.out.log
*.err.log

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
*.egg

# Build / packaging outputs (any depth)
build/
dist/
**/build/
**/dist/

# Tooling / caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.cache/
scripts/_test_*.py
scripts/_scratch/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Celery / local runtime ---
celerybeat-schedule*
celerybeat.pid
*.pid

# --- ERP export dumps (may contain password hashes) ---
backend/scripts/exports/*
!backend/scripts/exports/.gitkeep

# --- App uploads (regulations, avatars) ---
backend/storage/

# Desktop packaging artifacts (rebuild via build_exe.bat / installer/build_installer.bat)
desktop/installer/payload/
*.exe
