# ERP SQL Server (1C database erp_pm). Read-only.
ERP_SQL_SERVER=ii1
ERP_SQL_DATABASE=erp_pm
ERP_SQL_DRIVER=SQL Server
ERP_SQL_ENCRYPT=no
ERP_SQL_TRUSTED_CONNECTION=yes
ERP_SQL_USER=
ERP_SQL_PASSWORD=

# Если ERP SQL недоступен: AUTH_STUB=true + USE_STUBS=true — вход для теста платформы (без проверки пароля 1С)
AUTH_STUB=false
ALLOW_LOCAL_REGISTRATION=true
DEV_MODE=false

# JWT session for desktop clients
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# API
API_HOST=0.0.0.0
API_PORT=7812

# LLM/VLM
LLM_PROVIDER=stub
LM_STUDIO_BASE_URL=http://192.168.1.157:1234
LM_STUDIO_MODEL=ministral-3-14b-instruct-2512
OCR_PAGES_PER_BATCH=3
CLAUDE_API_KEY=
CLAUDEHUB_BASE_URL=https://api.claudehub.fun
CLAUDEHUB_MODEL=claude-sonnet-4.6
CLAUDEHUB_MAX_BLOCKS_PER_CHUNK=120

# Cursor Cloud Agents (regulation creation + workflow constructor)
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.com
CURSOR_REGULATION_MODEL=composer-2.5
CURSOR_WORKFLOW_MODEL=composer

# Postgres: app (drafts/regulations/users) + platform schemas (runs, KPI, tools).
# Docker compose: port 5432. Локальный app-only Postgres main: 5435.
DATABASE_URL=postgresql+psycopg://constructor:constructor@127.0.0.1:5432/constructor
REGULATION_STORAGE_DIR=storage/regulations
WORKFLOW_STORAGE_DIR=storage/workflows

# Platform microservices
TOOL_IMAP_URL=http://127.0.0.1:7821
TOOL_ONEC_URL=http://127.0.0.1:7822
TOOL_SHELL_URL=http://127.0.0.1:7823
TOOL_SHELL_NATIVE_URL=http://127.0.0.1:7828
TOOL_BROWSER_URL=http://127.0.0.1:7824
TOOL_COM_URL=http://127.0.0.1:7826
TOOL_FS_URL=http://127.0.0.1:7827
TOOL_DESKTOP_HOST_URL=http://127.0.0.1:7830
TOOL_DESKTOP_LAUNCHER_URL=http://127.0.0.1:7829
KPI_SERVICE_URL=http://127.0.0.1:7820
ORCHESTRATOR_URL=http://127.0.0.1:7825
ORCHESTRATOR_BROKER=amqp://guest:guest@127.0.0.1:5673//

USE_STUBS=true
# JSON ACL: {"default": [...], "by_department": {"Отдел МТО": [...]}}
TOOL_MANIFEST_PATH=data/tool_manifest.json

# IMAP — серверные tools (imap.*). Без credentials работает stub-режим.
# При заданных IMAP_* — реальный ящик (скопируйте значения в backend/.env, не в git).
# IMAP_HOST=mail.turbo-don.ru
# IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_CONNECT_TIMEOUT_SEC=120

# 1C OData — серверные tools (onec.odata_*, onec.sql_query). Без URL/credentials — stub.
# ODATA_BASE_URL=http://192.168.2.229:81/erp_pm/odata/standard.odata
# ODATA_USERNAME=
# ODATA_PASSWORD=
# ODATA_TIMEOUT_SEC=60
# ODATA_INCOMING_DOC_ENTITY=Document_ТД_ВходящаяКорреспонденция
# ERP_LOGIN=
# ERP_PASSWORD=
# Пустой allowlist: любые стандартные Document_/Catalog_/*Register_* плюс сущности из onec.odata_catalog.
# ONEC_ODATA_ENTITY_ALLOWLIST=Document_ТД_ВходящаяКорреспонденция,Document_ТД_ИсходящаяКорреспонденция
# ONEC_SQL_ALLOWLIST=dbo.v8users,v8users
