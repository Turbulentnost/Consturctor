# ERP SQL Server (1C database erp_pm). Read-only.
ERP_SQL_SERVER=ii1
ERP_SQL_DATABASE=erp_pm
ERP_SQL_DRIVER=ODBC Driver 18 for SQL Server
ERP_SQL_ENCRYPT=no
ERP_SQL_TRUSTED_CONNECTION=yes
ERP_SQL_USER=
ERP_SQL_PASSWORD=

# JWT session for desktop clients
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# API
API_HOST=0.0.0.0
API_PORT=7812

# LLM: stub | openai_compat (future)
LLM_PROVIDER=stub

# Platform PostgreSQL (runs, KPI, tool audit)
DATABASE_URL=postgresql+psycopg://constructor:constructor@127.0.0.1:5432/constructor

# Platform microservices
TOOL_IMAP_URL=http://127.0.0.1:7821
TOOL_ONEC_URL=http://127.0.0.1:7822
TOOL_SHELL_URL=http://127.0.0.1:7823
TOOL_BROWSER_URL=http://127.0.0.1:7824
KPI_SERVICE_URL=http://127.0.0.1:7820
ORCHESTRATOR_URL=http://127.0.0.1:7825
ORCHESTRATOR_BROKER=amqp://guest:guest@127.0.0.1:5672//

USE_STUBS=true
# Optional JSON manifest: {"default": ["imap.*"], "by_department": {"Отдел МТО": ["onec.*"]}}
TOOL_MANIFEST_PATH=
