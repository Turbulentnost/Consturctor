# Подключение к SQL Server (база 1С erp_pm). Только чтение!
# Скопируйте в .env и заполните. Файл .env не коммитить.

# Сервер: ii1 (внутренний хост = 192.168.1.157). Не localhost.
# Сырой IP ломает Windows Auth (ошибка 18452) — нужен hostname.
DB_SERVER=ii1
DB_NAME=erp_pm

# TrustedConnection=yes — Windows-аутентификация (рекомендуется, если так открыт SSMS)
# TrustedConnection=no — логин/пароль SQL Server
TrustedConnection=yes
DB_USER=
DB_PASSWORD=

# Драйвер ODBC (обычно уже установлен)
ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Куда писать результат (относительно корня репозитория Constructor)
OUTPUT_PATH=backend/scripts/exports/erp_pm_users_export.txt
