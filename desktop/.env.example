BACKEND_URL=http://127.0.0.1:7812
LM_STUDIO_BASE_URL=http://192.168.1.157:1234
LM_STUDIO_MODEL=ministral-3-14b-instruct-2512
LM_STUDIO_OCR_MODEL=ministral-3-14b-instruct-2512
CHAT_ENCRYPTION_KEY=constructor-chat-dev-change-me
ONEC_COM_PROGID=V83.COMConnector
ONEC_COM_SERVER=192.168.2.229
ONEC_COM_REF=erp_pm
ERP_LOGIN=
ERP_PASSWORD=
# Имя пользователя 1С для COM Usr=, только если отличается от ФИО входа (erp_pm обычно — полное ФИО):
# ONEC_COM_USR=
# Пароль COM берётся из сессии Orchestrator (экран входа) в ERP_PASSWORD; для dev без UI:
# ERP_LOGIN=Фамилия Имя Отчество
# ERP_PASSWORD=
# OData/gateway может использовать nameMail (v8users.Name) отдельно — не подставляйте его в ONEC_COM_USR без необходимости.
# Временно скрыть страницу входа и войти как ERP_LOGIN (пароль тот же, что для COM).
# AUTH_SKIP_LOGIN_PAGE=1
# COM-сессия 1С для чтения служебных записок. Пароль не коммитьте.
# Optional override if you want to provide the full COM string yourself:
# ONEC_COM_CONNECTION_STRING=Srvr=192.168.2.229;Ref=erp_pm;Usr=user;Pwd=password
ONEC_COM_SEARCH_METHOD=SearchDocuments
ONEC_COM_GET_DOCUMENT_CARD_METHOD=GetDocumentCard
ONEC_COM_SEARCH_TASKS_METHOD=SearchTasks
ONEC_COM_GET_TASK_CARD_METHOD=GetTaskCard
