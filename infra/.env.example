# Docker Compose environment (copy to infra/.env)

RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_HOST_PORT=15673

USE_STUBS=true
AUTH_STUB=true
DEV_MODE=true

# Split-auth: desktop AUTH_URL=http://192.168.1.157:7812 + BACKEND_URL=http://127.0.0.1:7812
# JWT_SECRET на локальном gateway ДОЛЖЕН совпадать с общим сервером входа.
# JWT_SECRET=change-me-in-production-stub-key-32b

# Cursor Cloud Agents — обязателен для выделения функций из регламента
# CURSOR_API_KEY=crsr_...
# CURSOR_REGULATION_MODEL=composer-2.5
# CURSOR_WORKFLOW_MODEL=composer-2.5

# IMAP — обязательны для sandbox IMAP (без них будет ошибка, не фейковые письма).
# При заданных IMAP_* sandbox ходит в реальный ящик, даже при USE_STUBS=true.
# Yandex 360 / корпоративная почта:
# IMAP_HOST=imap.yandex.ru
# IMAP_PORT=993
# IMAP_USERNAME=your-mailbox@turbo-don.ru
# IMAP_PASSWORD=app-password-or-mail-password
# IMAP_MAILBOX=INBOX
# IMAP_CONNECT_TIMEOUT_SEC=120

# Desktop tools on Windows host (orchestrator in Docker uses host.docker.internal)
# Unified desktop gateway (recommended):
#   TOOL_DESKTOP_HOST_URL=http://host.docker.internal:7830
#   TOOL_DESKTOP_LAUNCHER_URL=http://host.docker.internal:7829
# 1C thin client COM microservice (32-bit Python, port 7831):
#   TOOL_ONEC_COM_URL=http://host.docker.internal:7831
#   scripts\ensure_com_python.cmd && scripts\start_onec_com_service.cmd
# Launch turbobot desktop app OR scripts\start_desktop_launcher.cmd on Windows host.
# TOOL_COM_URL=http://host.docker.internal:7826
# TOOL_FS_URL=http://host.docker.internal:7827
# TOOL_SHELL_NATIVE_URL=http://host.docker.internal:7828
# FS_ROOT_ALLOWLIST=C:\Incoming,C:\Work\agent
# SHELL_CWD_ROOTS=C:\Incoming,C:\Work\agent
# COM_APPS={"onec":"V83.Application","outlook":"Outlook.Application","excel":"Excel.Application"}
# 1C COM (32-bit Python required — scripts\ensure_com_python.cmd)
# ERP_LOGIN=Иванов Иван Иванович
# ERP_PASSWORD=secret
# ONEC_COM_SERVER=192.168.2.229
# ONEC_COM_REF=erp_pm
# ONEC_COM_PROGID=V83.COMConnector
# ONEC_COM_PYTHON=C:\Users\you\AppData\Local\Programs\Python\Python312-32\python.exe

# Gateway ERP SQL (optional; from container use host.docker.internal or corporate DNS)
ERP_SQL_SERVER=host.docker.internal
ERP_SQL_DATABASE=erp_pm
ERP_SQL_DRIVER=ODBC Driver 18 for SQL Server
ERP_SQL_TRUSTED_CONNECTION=no
ERP_SQL_USER=
ERP_SQL_PASSWORD=

# 1C OData (входящая корреспонденция — реальные номера НП00-*, АЛ00-*)
# ODATA_BASE_URL=http://192.168.2.229:81/erp_pm/odata/standard.odata
# ODATA_USERNAME=
# ODATA_PASSWORD=
# ODATA_INCOMING_DOC_ENTITY=Document_ТД_ВходящаяКорреспонденция

# Allowlists (comma-separated). Defaults cover document-flow OData entities and dbo.v8users.
# ONEC_ODATA_ENTITY_ALLOWLIST=Document_ТД_ВходящаяКорреспонденция,Document_ТД_ИсходящаяКорреспонденция
# ONEC_SQL_ALLOWLIST=dbo.v8users,v8users

# Browser worker URL whitelist (platform-tool-browser, port 7824)
# URL_WHITELIST=localhost,127.0.0.1,yandex.ru,ya.ru,google.com,duckduckgo.com,donnews.ru,ria.ru,rbc.ru

# Cron jobs dispatcher (Celery Beat, platform-orchestrator-beat)
# CRON_DISPATCH_SECONDS=60

# Orchestrator / gateway tool ACL (optional)
# TOOL_MANIFEST_PATH=backend/data/tool_manifest.json
